import Overload

/-!
# The citation index

`lake exe citations [path]` reads the `std` and `assumed` attributes back out
of the compiled environment and writes the index as Markdown: what rests on
each sentence, and which in-scope paragraphs have no counterpart in the
model yet.

`lake exe citations --list` prints one `stable para` line per cited
paragraph, and `--pin` prints the draft pin, for `scripts/drift-check.sh`.
-/

open Lean Overload.Std

namespace Overload.Tools

/-- One tagged declaration. -/
structure Row where
  decl : Name
  module : String
  entry : Entry

private def moduleOf (env : Environment) (decl : Name) : String :=
  match env.getModuleIdxFor? decl with
  | some i => toString env.header.moduleNames[i.toNat]!
  | none => "?"

/-- Every tagged declaration, in citation order. -/
def rows (env : Environment) : Array Row :=
  let rs := (ParametricAttribute.allEntries stdAttr env).flatMap fun (n, es) =>
    es.map fun e => { decl := n, module := moduleOf env n, entry := e : Row }
  rs.qsort fun a b =>
    let ca := a.entry.cite
    let cb := b.entry.cite
    if ca.stable ≠ cb.stable then ca.stable < cb.stable
    else if ca.para ≠ cb.para then ca.para < cb.para
    else if ca.sentence ≠ cb.sentence then ca.sentence.getD 0 < cb.sentence.getD 0
    else if a.entry.role ≠ b.entry.role then toString a.entry.role < toString b.entry.role
    else a.decl.toString < b.decl.toString

/-- The cited paragraphs, deduplicated and sorted. -/
def paragraphs (env : Environment) : Array (String × Nat) :=
  let ps := (rows env).map fun r => (r.entry.cite.stable, r.entry.cite.para)
  (ps.foldl (fun acc p => if acc.contains p then acc else acc.push p) #[]).qsort
    fun a b => a.1 < b.1 || (a.1 = b.1 && a.2 < b.2)

/-- The in-scope paragraphs nothing cites yet. -/
def uncovered (env : Environment) : List (String × Nat) :=
  let cited := paragraphs env
  inScope.filter fun p => !cited.contains p

/-- The Markdown index. -/
def render (env : Environment) : String := Id.run do
  let pin := draftPin
  let mut out := ""
  out := out ++ "# Citation index\n\n"
  out := out ++ "<!-- Generated by `lake exe citations` (make citations) from the compiled "
  out := out ++ "environment. Do not edit; CI checks it is current. -->\n\n"
  out := out ++ s!"Every citation is read against {pin.document}, tag `{pin.tag}` of the "
  out := out ++ s!"cplusplus/draft repository, commit `{pin.commit}` (docs/decisions.md#draft-pin). "
  out := out ++ "A sentence number uses the draft's own anchors, as rendered at eel.is.\n\n"
  out := out ++ "## What rests on each sentence\n\n"
  out := out ++ "| Citation | Role | Declaration | Module |\n|---|---|---|---|\n"
  for r in rows env do
    let c := r.entry.cite
    out := out ++ s!"| [{c}]({c.url}) | {r.entry.role} | `{r.decl}` | `{r.module}` |\n"
  out := out ++ "\n## In scope, no counterpart yet\n\n"
  let u := uncovered env
  if u.isEmpty then
    out := out ++ "Every in-scope paragraph has a counterpart in the model.\n"
  else
    for (s, p) in u do
      out := out ++ s!"- [[{s}]/{p}](https://eel.is/c++draft/{s}#{p})\n"
  out := out ++ "\n## Assumptions\n\n"
  out := out ++ "What the model needs and the Standard does not say, each linked to its "
  out := out ++ "decision-log entry.\n\n| Decision | Declaration |\n|---|---|\n"
  let assumptions := (ParametricAttribute.allEntries assumedAttr env).qsort
    fun a b => a.2 < b.2 || (a.2 = b.2 && a.1.toString < b.1.toString)
  for (n, d) in assumptions do
    out := out ++ s!"| [{d}](decisions.md#{d}) | `{n}` |\n"
  return out

end Overload.Tools

open Overload.Tools in
unsafe def main (args : List String) : IO UInt32 := do
  initSearchPath (← findSysroot)
  withImportModules #[{ module := `Overload }] {} fun env => do
    match args with
    | ["--pin"] =>
      IO.println s!"{draftPin.tag} {draftPin.commit} {draftPin.document}"
    | ["--list"] =>
      for (s, p) in paragraphs env do
        IO.println s!"{s} {p}"
    | [] => IO.print (render env)
    | [path] =>
      IO.FS.writeFile path (render env)
      IO.println s!"wrote {path}: {(rows env).size} citations, {(uncovered env).length} in-scope paragraphs uncovered"
    | _ =>
      IO.eprintln "usage: lake exe citations [--pin | --list | path]"
      return 1
    return 0

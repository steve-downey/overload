import Overload.Steps
import Overload.Ordering

/-!
# Overload resolution, and the P3606 switch

The call surface, as far as the plan's step-order question needs it:

1. the candidate functions ([over.match.funcs.general]/8): each function
   template contributes the specialization its deduction produces, or
   nothing when deduction fails softly, and a hard error in any
   candidate's deduction is the outcome of the whole resolution;
2. the viable functions ([over.match.viable]): arity, with default
   arguments, and an implicit conversion sequence for every argument;
3. the best viable function ([over.match.best.general]/2 and /3): by
   conversion sequences, then a non-template over a template
   specialization, then partial ordering of templates, which is a
   parameter until phase 4 supplies it.

The conversion ranking is a parameter, `Ranking`, per the
`ranking-fidelity` decision: which conversion sequences exist and which
is better.

`Mode` is the switch of the `p3606-mode` decision. Under `.text`, the
C++26 text, deduction runs for every function template candidate. Under
`.p3606`, a non-template candidate that is a perfect match suppresses
deduction for the templates, which is what GCC does today. The two modes
are compared by `generate_agree_of_no_perfect` and
`generate_p3606_suppresses`: they differ exactly when a perfect match
exists, and then only in that the templates are never deduced, so the
step-order hazard cannot reach them.
-/

namespace Overload

/-- Which text the candidate step transcribes. -/
inductive Mode where
  /-- The C++26 text: candidate specializations are generated by deduction
  for every function template. -/
  | text
  /-- The P3606 rule: a perfect non-template match suppresses deduction
  for the template candidates. -/
  | p3606
  deriving Repr, DecidableEq, Inhabited

/-- The conversion ranking, a parameter of the model: which implicit
conversion sequences exist, and which is the better one. -/
structure Ranking (Conv : Type) where
  /-- The implicit conversion sequence from an argument to a parameter
  type, if there is one. Forming it may instantiate, a conversion function
  template for one, so the answer is a `Subst`. -/
  ics : CallArg → Ty → Subst (Option Conv)
  /-- `better c₁ c₂`: `c₁` is a better conversion sequence than `c₂`
  ([over.ics.rank]). -/
  better : Conv → Conv → Bool

/-- A candidate function: a non-template function, or the specialization
deduced for a function template. `index` is its position among the
declarations with the callee's name. -/
structure Candidate where
  index : Nat
  params : List Ty
  defaultArgs : Nat := 0
  specialization : Option Specialization := none
  deriving Repr, DecidableEq, Inhabited

/-- Is the candidate a function template specialization? -/
def Candidate.isTemplate (c : Candidate) : Bool := c.specialization.isSome

/-! ## The P3606 perfect match -/

/-- A parameter is a perfect match for an argument, as the model reads
P3606: the parameter's type is the argument's own type, with the
argument's value category when the parameter is a reference, so that no
template specialization could bind better. The proposal's wording is not
settled; this reading is the `p3606-mode` assumption. -/
@[assumed "p3606-mode"]
def perfectParam (a : CallArg) (p : Ty) : Bool :=
  p == a.ty.stripConst || (a.lvalue && p == .lref a.ty) || (!a.lvalue && p == .rref a.ty)

/-- A non-template candidate is a perfect match when every argument has a
perfect parameter and no default argument is used. -/
def perfectMatch (args : List CallArg) (params : List Ty) : Bool :=
  args.length == params.length && (args.zip params).all fun (a, p) => perfectParam a p

/-- Does the candidate set hold a non-template perfect match? -/
def hasPerfectMatch (decls : List Decl) (args : List CallArg) : Bool :=
  decls.any fun
    | .function _ ps _ => perfectMatch args ps
    | _ => false

/-! ## Candidate functions -/

/-- The candidate functions of a call, in declaration order. A function
template contributes the specialization its deduction produces; a soft
failure contributes nothing; a hard failure is the outcome. Under
`.p3606`, when a non-template candidate is a perfect match, no template
is deduced. Explicit template arguments are given to each template's
deduction; which non-template functions a call with explicit template
arguments names is name lookup, outside the fragment, and no case has
one. -/
@[std rule "over.match.funcs.general#8.sentence-1"]
def generate (mode : Mode) (env : Env) (decls : List Decl) (args : List CallArg)
    (explicit : List Ty := []) : Subst (List Candidate) :=
  go decls 0 (mode matches .p3606 && hasPerfectMatch decls args)
where
  go : List Decl → Nat → Bool → Subst (List Candidate)
    | [], _, _ => .ok []
    | .function _ ps _ :: ds, i, s => do
      return { index := i, params := ps } :: (← go ds (i + 1) s)
    | .functionTemplate ft :: ds, i, s =>
      if s then go ds (i + 1) s
      else
        match deduceTemplate env ft explicit args with
        | .ok sp => do
          return { index := i, params := sp.params, defaultArgs := ft.defaultArgs
                   specialization := some sp } :: (← go ds (i + 1) s)
        | .soft _ => go ds (i + 1) s
        | .hard r => .hard r
    | _ :: ds, i, s => go ds (i + 1) s

/-! ## Viable functions -/

/-- A viable function and the conversion sequence for each argument. -/
structure Viable (Conv : Type) where
  cand : Candidate
  convs : List Conv

/-- Enough parameters to agree in number with the arguments: exactly as
many, or more if the rest have default arguments. No ellipsis in the
fragment. -/
@[std rule "over.match.viable#2.sentence-1"]
def arityOk (c : Candidate) (m : Nat) : Bool :=
  c.params.length == m || (m < c.params.length && c.params.length ≤ m + c.defaultArgs)

/-- An implicit conversion sequence for each argument, or `none` when some
argument has none. -/
@[std rule "over.match.viable#4.sentence-1"]
def conversions (r : Ranking Conv) : List CallArg → List Ty → Subst (Option (List Conv))
  | [], _ => .ok (some [])
  | _ :: _, [] => .ok none
  | a :: as, p :: ps => do
    match ← r.ics a p with
    | none => return none
    | some c =>
      match ← conversions r as ps with
      | none => return none
      | some cs => return some (c :: cs)

/-- The viable functions among the candidates. A template specialization
had its constraints checked by deduction; the fragment's non-template
functions have none ([over.match.viable]/3). -/
def viable (r : Ranking Conv) (cs : List Candidate) (args : List CallArg) :
    Subst (List (Viable Conv)) :=
  go cs
where
  go : List Candidate → Subst (List (Viable Conv))
    | [] => .ok []
    | c :: cs => do
      if arityOk c args.length then
        match ← conversions r args c.params with
        | some convs => return { cand := c, convs } :: (← go cs)
        | none => go cs
      else go cs

/-! ## The best viable function -/

/-- `F₁` is a better function than `F₂`: for all arguments its conversion
sequence is not worse, and then for some argument it is better, or, if
not that, `F₁` is not a template specialization and `F₂` is, or, if not
that, both are and `F₁`'s template is more specialized. The contexts the
fragment lacks (user-defined conversions, rewritten candidates, deduction
guides) are skipped; partial ordering is the `moreSpecialized` parameter
until phase 4. -/
@[std rule "over.match.best.general#2"]
def betterFunction (r : Ranking Conv) (moreSpecialized : Specialization → Specialization → Bool)
    (f₁ f₂ : Viable Conv) : Bool :=
  let pairs := f₁.convs.zip f₂.convs
  let notWorse := pairs.all fun (c₁, c₂) => !r.better c₂ c₁
  let someBetter := pairs.any fun (c₁, c₂) => r.better c₁ c₂
  let nonTemplate := !f₁.cand.isTemplate && f₂.cand.isTemplate
  let ordered := match f₁.cand.specialization, f₂.cand.specialization with
    | some s₁, some s₂ => moreSpecialized s₁ s₂
    | _, _ => false
  notWorse && (someBetter || nonTemplate || ordered)

/-- If there is exactly one viable function that is a better function
than all other viable functions, it is the one selected; otherwise the
call is ill-formed, and with no viable function at all, overload
resolution fails. -/
@[std rule "over.match.best.general#3.sentence-1"]
def bestViable (r : Ranking Conv) (moreSpecialized : Specialization → Specialization → Bool)
    (vs : List (Viable Conv)) : Resolution Candidate :=
  match vs with
  | [] => .noMatch
  | _ =>
    let best := vs.filter fun w => vs.all fun f =>
      f.cand.index == w.cand.index || betterFunction r moreSpecialized w f
    match best with
    | [w] => .selected w.cand
    | [] => .ambiguous (vs.map (·.cand))
    | ws => .ambiguous (ws.map (·.cand))

/-- Partial ordering in the context of a call with `m` arguments, on the
templates of two specializations. -/
def orderingForCall (m : Nat) (s₁ s₂ : Specialization) : Bool :=
  PartialOrdering.moreSpecialized (some m) s₁.template s₂.template

/-- Overload resolution for a call: the candidates, the viable ones, the
best. A hard error anywhere is the outcome. -/
def resolve (mode : Mode) (env : Env) (r : Ranking Conv)
    (decls : List Decl) (args : List CallArg) (explicit : List Ty := []) : Resolution Candidate :=
  match generate mode env decls args explicit with
  | .hard reason | .soft reason => .illFormed reason
  | .ok cs =>
    match viable r cs args with
    | .hard reason | .soft reason => .illFormed reason
    | .ok vs => bestViable r (orderingForCall args.length) vs

/-! ## The two modes compared -/

/-- Without a perfect non-template match, the switch does nothing: both
modes generate the same candidates. -/
theorem generate_agree_of_no_perfect (env : Env) (decls : List Decl) (args : List CallArg)
    (h : hasPerfectMatch decls args = false) :
    generate .text env decls args = generate .p3606 env decls args := by
  simp [generate, h]

/-- Without a perfect non-template match, both modes resolve the call the
same way. -/
theorem resolve_agree_of_no_perfect (env : Env) (r : Ranking Conv)
    (decls : List Decl) (args : List CallArg)
    (h : hasPerfectMatch decls args = false) :
    resolve .text env r decls args = resolve .p3606 env r decls args := by
  simp [resolve, generate_agree_of_no_perfect env decls args h]

/-- With suppression on, generation never deduces: every candidate is a
non-template function and nothing fails. -/
theorem generate_go_suppressed (env : Env) (args : List CallArg) (explicit : List Ty) :
    ∀ (ds : List Decl) (i : Nat), ∃ cs, generate.go env args explicit ds i true = .ok cs ∧
      cs.all (fun c => !c.isTemplate) = true := by
  intro ds
  induction ds with
  | nil => intro i; exact ⟨[], rfl, rfl⟩
  | cons d ds ih =>
    intro i
    obtain ⟨cs, hcs, hall⟩ := ih (i + 1)
    cases d with
    | function n ps =>
      refine ⟨{ index := i, params := ps } :: cs, ?_, ?_⟩
      · simp [generate.go, hcs]
      · rw [List.all_cons]
        simpa [Candidate.isTemplate] using hall
    | functionTemplate ft => exact ⟨cs, by simp [generate.go, hcs], hall⟩
    | «class» n bs ps => exact ⟨cs, by simp [generate.go, hcs], hall⟩
    | classTemplate n h => exact ⟨cs, by simp [generate.go, hcs], hall⟩
    | lookup c => exact ⟨cs, by simp [generate.go, hcs], hall⟩
    | lookupHard c => exact ⟨cs, by simp [generate.go, hcs], hall⟩
    | «instance» c h p => exact ⟨cs, by simp [generate.go, hcs], hall⟩
    | use c t => exact ⟨cs, by simp [generate.go, hcs], hall⟩
    | object n => exact ⟨cs, by simp [generate.go, hcs], hall⟩
    | concept n b => exact ⟨cs, by simp [generate.go, hcs], hall⟩
    | dependentCall callee args sc => exact ⟨cs, by simp [generate.go, hcs], hall⟩
    | refersTo call => exact ⟨cs, by simp [generate.go, hcs], hall⟩
    | converting cls conv => exact ⟨cs, by simp [generate.go, hcs], hall⟩
    | member cls m => exact ⟨cs, by simp [generate.go, hcs], hall⟩
    | special cls s => exact ⟨cs, by simp [generate.go, hcs], hall⟩
    | conceptDef n a body => exact ⟨cs, by simp [generate.go, hcs], hall⟩
    | semantic c law => exact ⟨cs, by simp [generate.go, hcs], hall⟩

/-- With a perfect non-template match, the P3606 mode never deduces a
template: the candidates are the non-template functions and generation
cannot fail, so the step-order hazard cannot reach the call. -/
theorem generate_p3606_suppresses (env : Env) (decls : List Decl) (args : List CallArg)
    (h : hasPerfectMatch decls args = true) :
    ∃ cs, generate .p3606 env decls args = .ok cs ∧ cs.all (fun c => !c.isTemplate) = true := by
  simp only [generate, h, Bool.and_true]
  exact generate_go_suppressed env args [] decls 0

/-- The modes differ only on the hazard: if the text makes a call
ill-formed in candidate generation and P3606 does not, a perfect
non-template match exists. -/
theorem generate_differ_implies_perfect (env : Env) (decls : List Decl) (args : List CallArg)
    (r : Reason) (ht : generate .text env decls args = .hard r)
    (hp : generate .p3606 env decls args ≠ .hard r) :
    hasPerfectMatch decls args = true := by
  cases hh : hasPerfectMatch decls args with
  | true => rfl
  | false =>
    rw [generate_agree_of_no_perfect env decls args hh] at ht
    exact absurd ht hp

/-! ## A concrete ranking -/

/-- The smallest ranking: identity conversions only, with reference
binding, and nothing better than anything. The unit tests use it; the
emitted cases use the program's ranking, `Program.ranking`. -/
def identityRanking : Ranking Unit :=
  { ics := fun a t =>
      let same := a.ty.referred.stripConst == t.referred.stripConst
      let binds := match t with
        | .lref (.const _) => true
        | .lref _ => a.lvalue
        | .rref _ => !a.lvalue
        | _ => true
      .ok (if same && binds then some () else none)
    better := fun _ _ => false }

/-! ## Resolution depends on the environment only through deduction -/

theorem generate_go_congr (env₁ env₂ : Env) (args : List CallArg) (explicit : List Ty) (s : Bool) :
    ∀ (ds : List Decl), (∀ ft, .functionTemplate ft ∈ ds →
        deduceTemplate env₁ ft explicit args = deduceTemplate env₂ ft explicit args) →
      ∀ i, generate.go env₁ args explicit ds i s = generate.go env₂ args explicit ds i s := by
  intro ds
  induction ds with
  | nil => intro _ _; rfl
  | cons d ds ih =>
    intro h i
    have ih' := ih (fun ft hm => h ft (List.mem_cons_of_mem _ hm)) (i + 1)
    cases d with
    | functionTemplate ft =>
      simp only [generate.go]
      rw [h ft List.mem_cons_self, ih']
    | _ => simp only [generate.go, ih']

/-- Two environments that give every candidate template the same
deduction give the call the same resolution. -/
theorem resolve_congr (mode : Mode) (env₁ env₂ : Env) (r : Ranking Conv)
    (decls : List Decl) (args : List CallArg) {explicit : List Ty}
    (h : ∀ ft, .functionTemplate ft ∈ decls →
      deduceTemplate env₁ ft explicit args = deduceTemplate env₂ ft explicit args) :
    resolve mode env₁ r decls args explicit = resolve mode env₂ r decls args explicit := by
  simp only [resolve, generate, generate_go_congr env₁ env₂ args explicit _ decls h]

theorem generate_go_hard (env : Env) (args : List CallArg) (explicit : List Ty)
    (ft : FunctionTemplate) (e : Reason) (hd : deduceTemplate env ft explicit args = .hard e) :
    ∀ (ds : List Decl), .functionTemplate ft ∈ ds →
      ∀ i, ∃ e', generate.go env args explicit ds i false = .hard e' := by
  intro ds
  induction ds with
  | nil => intro hm; cases hm
  | cons d ds ih =>
    intro hm i
    rcases List.mem_cons.mp hm with rfl | hm
    · exact ⟨e, by simp [generate.go, hd]⟩
    · obtain ⟨e', he'⟩ := ih hm (i + 1)
      cases d with
      | function n ps => exact ⟨e', by simp [generate.go, he']⟩
      | functionTemplate ft' =>
        simp only [generate.go, Bool.false_eq_true, ↓reduceIte]
        cases deduceTemplate env ft' explicit args with
        | ok sp => exact ⟨e', by rw [he']; rfl⟩
        | soft _ => exact ⟨e', he'⟩
        | hard r => exact ⟨r, rfl⟩
      | _ => exact ⟨e', by simp [generate.go, he']⟩

/-- Under the text, a hard error in any candidate template's deduction
makes the call ill-formed. -/
theorem resolve_text_hard (env : Env) (r : Ranking Conv) (decls : List Decl)
    (args : List CallArg) {explicit : List Ty} (ft : FunctionTemplate) (e : Reason)
    (hm : .functionTemplate ft ∈ decls) (hd : deduceTemplate env ft explicit args = .hard e) :
    ∃ e', resolve .text env r decls args explicit = .illFormed e' := by
  obtain ⟨e', he'⟩ := generate_go_hard env args explicit ft e hd decls hm 0
  exact ⟨e', by simp [resolve, generate, he']⟩

end Overload
